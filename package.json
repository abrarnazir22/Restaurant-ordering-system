{
  "name": "ember-and-brew-api",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/api/api-runner.js && playwright test",
    "test:all": "node tests/api/api-runner.js && node scripts/db-quality-check.js && node scripts/synthetic-monitor.js && node tests/performance/run-perf.js && playwright test",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "node tests/api/api-runner.js",
    "test:security": "playwright test tests/security",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js",
    "test:perf": "node tests/performance/run-perf.js",
    "test:k6": "k6 run performance/k6/load-test.js",
    "test:k6:50": "k6 run --vus 50 --duration 15s performance/k6/load-test.js",
    "test:k6:100": "k6 run --vus 100 --duration 15s performance/k6/load-test.js",
    "test:k6:500": "k6 run --vus 500 --duration 15s performance/k6/load-test.js",
    "db:quality": "node scripts/db-quality-check.js",
    "monitor": "node scripts/synthetic-monitor.js",
    "seed": "node src/seeds.js",
    "seed:orders": "node src/seedOrders.js",
    "restore:menu": "node scripts/restoreDefaultMenu.js",
    "backfill:branch-data": "node scripts/backfillBranchData.js",
    "seed:london": "node scripts/seedLondonBranch.js",
    "seed:australia": "node scripts/seedAustraliaBranch.js",
    "merge:london-into-uk": "node scripts/mergeLondonIntoUk.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  }
}
